// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Berita {
  id        String    @id @default(uuid()) @db.Uuid
  title     String    @db.Text
  content   String    @db.Text
  excerpt   String?   @db.Text
  image     String?   @db.Text
  
  category  String?   @db.VarChar(100)
  tags      String[]  
  
  authorId  String    @map("author_id") @db.Uuid
  author    User      @relation(fields: [authorId], references: [id])
  
  date      DateTime? @default(now()) @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("berita") 
}


enum PengumumanType {
  teks
  link
  file
}

enum PengumumanTarget {
  semua
  siswa
  orangtua
  guru
  pegawai
  siswa_tertentu
}

model Pengumuman {
  id            String           @id @default(uuid()) @db.Uuid
  title         String
  content       String           @db.Text
  date          DateTime?        @default(now()) @db.Timestamptz()
  important     Boolean?         @default(false)
  
  // Fitur baru menyesuaikan FE
  type          PengumumanType   @default(teks)
  linkUrl       String?          @map("link_url")
  
  // Postgres sakti: Bisa nyimpen array of object [{name: "abc", url: "xyz"}] lewat tipe Json
  files         Json?            @default("[]") 
  
  target        PengumumanTarget @default(semua)
  targetDetails String[]         @map("target_details") // Menyimpan array of string (misal daftar kelas atau ID siswa)

  // Relasi Skenario B: Siapa yang bikin?
  createdById   String           @map("created_by_id") @db.Uuid
  createdBy     User             @relation(fields: [createdById], references: [id])

  // Periode pengumuman aktif (penting buat mading digital)
  startDate     DateTime?        @map("start_date") @db.Timestamptz()
  endDate       DateTime?        @map("end_date") @db.Timestamptz()

  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("pengumuman")
}

model Guru {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  nip         String   @unique
  position    String?
  subject     String   
  photo       String?
  education   String?
  email       String? 

  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("guru")
}

model Pegawai {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  nip         String   @unique
  position    String   
  division    String?
  photo       String?
  contact     String? 

  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("pegawai")
}

model Ekskul {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String   @db.Text   
  image       String?             
  schedule    String              
  coach       String              
  
  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("ekskul")
}

model Prestasi {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  date         DateTime @db.Timestamptz() 
  level        String   
  category     String   
  image        String?
  participants String?

  createdById  String   @map("created_by_id") @db.Uuid
  createdBy    User     @relation(fields: [createdById], references: [id])

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("prestasi")
}

model Layanan {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String   
  url         String   
  icon        String?  
  category    String   

  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("layanan")
}

model Jurusan {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  slug                String   @unique
  description         String   
  image               String?
  icon                String?
  
  suitableFor         String[] @map("suitable_for")
  careerOpportunities String[] @map("career_opportunities")
  subjects            String[]
  practiceImages      String[] @map("practice_images")

  createdById         String   @map("created_by_id") @db.Uuid
  createdBy           User     @relation(fields: [createdById], references: [id])

  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("jurusan")
}

model KepalaSekolah {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  nip         String   
  photo       String   
  greeting    String   
  motto       String?  

  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("kepala_sekolah")
}

model MitraIndustri {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  logo            String?
  cooperationType String?  @map("cooperation_type")
  website         String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("mitra_industri")
}

model SocialMedia {
  id        String   @id @default(uuid()) @db.Uuid
  platform  String
  url       String
  icon      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("social_media")
}

model SiteSettings {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("site_settings")
}

enum Role {
  ADMIN
  GURU
  Osis
  SISWA
  ORANGTUA
  PEGAWAI
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  username  String   @unique 
  email     String?  @unique 
  password  String   
  role      Role     @default(SISWA)
  avatar    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  berita     Berita[]
  pengumuman Pengumuman[]
  ekskul     Ekskul[]
  guru       Guru[]
  pegawai    Pegawai[]
  prestasi   Prestasi[]
  layanan    Layanan[]
  kepalaSekolah KepalaSekolah[]
  jurusan       Jurusan[]

  @@map("users")
}